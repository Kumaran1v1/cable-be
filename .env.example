# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.btij4ee.mongodb.net/cable_db?retryWrites=true&w=majority&appName=Cluster0
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.btij4ee.mongodb.net/cable_db?retryWrites=true&w=majority&appName=Cluster0

# Database (Local MongoDB)
# MONGO_URI=mongodb://127.0.0.1:27017/cable_db
# DATABASE_URL=mongodb://127.0.0.1:27017/cable_db

# Security & Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h

# Frontend URLs
FRONTEND_URL=https://cable-fe.onrender.com
LOCAL_FRONTEND_URL=http://localhost:5173
